# Discord bot token from the Discord Developer Portal.
# Never commit a real token.
TOKEN=replace_with_your_discord_bot_token

# Discord server ID used for quick slash-command registration.
GUILD_ID=replace_with_your_discord_server_id

# Channel ID where automatic topic/deadline analysis should run.
TESTING_CHANNEL_ID=replace_with_your_testing_channel_id

# Channel used for the welcome message.
CHANNEL_NAME=general

# Ollama runs on the same laptop as the Discord bot.
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:3b
